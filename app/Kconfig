# BMS 应用级配置
mainmenu "BMS firmware configuration"

menu "BMS application"

config BMS_CELL_COUNT
	int "Number of series cells（串数）"
	range 1 256
	default 16
	help
	  电池组串联单体数量，决定每帧测量数组长度。

config BMS_TEMP_SENSOR_COUNT
	int "Number of temperature sensors（温度传感器数）"
	range 1 64
	default 4

config BMS_TASK_SAFETY_PERIOD_MS
	int "Safety cyclic task period (ms)"
	range 1 1000
	default 10
	help
	  foxBMS 2 inspired safety cyclic task period. This task evaluates
	  measurement/protection/BMS state machine work.

config BMS_TASK_APP_PERIOD_MS
	int "Application cyclic task period (ms)"
	range 10 60000
	default 100
	help
	  foxBMS 2 inspired application cyclic task period. This task runs
	  slower algorithms, balancing decisions, and communication reporting.

config BMS_AFE
	bool "AFE / 电芯采样模块"
	default y
	help
	  采集电压/电流/温度并写入 bms_db；周期由 bms_task 统一调度。

config BMS_AFE_SAMPLE_PERIOD_MS
	int "AFE 采样周期 (ms)"
	depends on BMS_AFE
	range 1 60000
	default 100

choice
	prompt "AFE 数据源后端"
	depends on BMS_AFE
	default BMS_AFE_BACKEND_SIM
	help
	  选择 afe 的采样实现后端（业务逻辑/线程不变，差异收敛到 bms_afe_backend_read()，
	  见 docs/design/concept-architecture.md「数据源后端可切换（afe）」）。

config BMS_AFE_BACKEND_STUB
	bool "stub（恒定桩数据）"
	help
	  返回固定电压/电流/温度，确定性最强，用于最小化烟雾测试。

config BMS_AFE_BACKEND_SIM
	bool "sim（充放电仿真模型）"
	help
	  三角充放电 + 库仑积分 + OCV 映射 + 温升，QEMU/native_sim 下产出"会动"的
	  可复现数据，供 soc/protection/balancing 拿到变化输入。

config BMS_AFE_BACKEND_ADC
	bool "adc（真实硬件，经 devicetree ADC/AFE 芯片）"
	help
	  真机后端：DEVICE_DT_GET 取 ADC/专用 AFE 芯片走设备 API。当前为占位，
	  待 bms_f405 板 dts 就绪后实现。

endchoice

# 测量合理性校验阈值（"读数是否物理可信"，区别于 protection 的保护阈值）。
# 取很宽的量程，只剔除明显坏帧（断线/量程溢出/ADC 异常），见架构「测量数据纪律」。
config BMS_AFE_PLAUSIBLE_CELL_MV_MIN
	int "单体电压合理下限 (mV)"
	depends on BMS_AFE
	default 0

config BMS_AFE_PLAUSIBLE_CELL_MV_MAX
	int "单体电压合理上限 (mV)"
	depends on BMS_AFE
	default 6000

config BMS_AFE_PLAUSIBLE_CURRENT_ABS_MAX_MA
	int "电流绝对值合理上限 (mA)"
	depends on BMS_AFE
	default 300000

config BMS_AFE_PLAUSIBLE_TEMP_DCI_MIN
	int "温度合理下限 (0.1℃)"
	depends on BMS_AFE
	default -400

config BMS_AFE_PLAUSIBLE_TEMP_DCI_MAX
	int "温度合理上限 (0.1℃)"
	depends on BMS_AFE
	default 1250

config BMS_SOC
	bool "SOC/SOH 估算模块"
	default y

config BMS_SOC_PACK_CAPACITY_MAH
	int "电池组额定容量 (mAh)"
	depends on BMS_SOC
	range 1 10000000
	default 100000
	help
	  库仑积分换算基准（额定容量，单位 mAh）。换算公式
	  ΔSOC(‰)=acc(mA·ms)/(容量×3600)。多板型适配请覆写，
	  禁止在算法中硬编码（REQ-SOC-C12）。

config BMS_SOC_INIT_FROM_VOLTAGE
	bool "上电用电压线性映射初始化 SOC 初值"
	depends on BMS_SOC
	default y
	help
	  y：首帧用 bms_soc_estimate 的电压映射(3000mV→0‰,4200mV→1000‰)
	  作为库仑积分起点（REQ-SOC-C04）。n：从 0‰ 起算（不推荐）。

config BMS_SOC_GAP_FACTOR_N
	int "丢帧判定因子 N（Δt 上限 = N × AFE 采样周期）"
	depends on BMS_SOC
	range 2 1000
	default 10
	help
	  帧间差 > N×CONFIG_BMS_AFE_SAMPLE_PERIOD_MS 判为丢帧，Δt 夹紧到
	  该上限，避免单帧 SOC 大幅跳变（REQ-SOC-C02-3、C06）。

config BMS_SOC_MAX_CURRENT_MA
	int "合理电流量程上限绝对值 (mA)"
	depends on BMS_SOC
	range 1 2000000
	default 200000
	help
	  |pack_current_ma| 超过此值判为坏数据，跳过本帧积分（REQ-SOC-C06）。
	  默认 ±200A，覆盖 C10 建议的 ±100A 测试量程并留裕量。

config BMS_PROTECTION
	bool "保护状态机模块"
	default y

config BMS_PROTECTION_PERIOD_MS
	int "保护评估周期 (ms)"
	depends on BMS_PROTECTION
	default 50

config BMS_BALANCING
	bool "单体均衡模块"
	default y

config BMS_COMM
	bool "CAN 通信模块"
	default y

config BMS_COMM_REPORT_PERIOD_MS
	int "CAN 上报周期 (ms)"
	depends on BMS_COMM
	range 10 60000
	default 200
	help
	  comm 模块对外 CAN 上报的固定周期（毫秒）。
	  下界 10ms 防止过密上报使最低优先级 comm 线程忙等、间接拖累
	  protection/afe 等安全相关线程（失效安全，REQ-COMM-005）；
	  上界 60000ms(60s) 为工程合理上限。默认 200ms 为现状基线。
	  运行期另有防御性钳制（bms_comm_clamp_period_ms）作第二道防线。
	  (DES-COMM-001; REQ-COMM-001/002/003/004)

endmenu

# 必须在文件末尾引入 Zephyr 的 Kconfig 树
source "Kconfig.zephyr"
