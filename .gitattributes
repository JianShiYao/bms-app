# Normalize line endings: store everything as LF in the repo.
# Keeps Windows (CRLF working copy) and Linux/CI (LF) consistent and stops
# clang-format / diffs from churning on line-ending differences.

# Default: treat as text, auto-detect, but always commit/checkout as LF.
* text=auto eol=lf

# Source / headers
*.c    text eol=lf
*.h    text eol=lf

# Build & config (Zephyr / CMake / Kconfig / devicetree)
*.cmake        text eol=lf
CMakeLists.txt text eol=lf
*.conf         text eol=lf
*.overlay      text eol=lf
*.dts          text eol=lf
*.dtsi         text eol=lf
Kconfig*       text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf

# Scripts (.sh MUST be LF to run on Linux/CI)
*.sh   text eol=lf
*.py   text eol=lf
*.ps1  text eol=lf

# Docs
*.md   text eol=lf
*.txt  text eol=lf

# Binary assets: never convert
*.bin  binary
*.elf  binary
*.hex  binary
*.a    binary
*.o    binary
*.png  binary
*.jpg  binary
*.pdf  binary
