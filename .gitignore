# Zephyr / west workspace
.west/
# 任意构建目录：build/、build-*/、WSL 的 build_native_wsl/ 等
build*/
twister-out/
twister-out.*/

# 由 west update 拉取的依赖（不入本仓库）
# 注意：本仓库自带 zephyr/module.yml（模块注册文件，必须入库），
# 故忽略 zephyr 目录内容但放行 module.yml。
/zephyr/*
!/zephyr/module.yml
/modules/
/tools/
/bootloader/

# 编译产物
*.o
*.obj
*.elf
*.exe
*.bin
*.hex
*.map
*.lst

# Claude Code 运行期临时文件
.claude/scheduled_tasks.lock

# 编辑器/IDE
.vscode/
.idea/
*.swp
compile_commands.json

# Python venv（工具链）
.venv/
__pycache__/

# cppcheck MISRA addon（GPLv3，按机器下载，不入库；见 scripts/setup-cppcheck-misra.sh）
scripts/.cppcheck-addons/
# cppcheck 分析中间产物
*.dump
*.ctu-info

# 硬件资料：体积大的二进制（数据手册 PDF / BOM xlsx / CubeMX ioc）不入库，
# 另存网盘或 Git LFS；仅保留 docs/reference/hardware/ 下的文本说明（.md/.txt）。
docs/reference/hardware/**/*.pdf
docs/reference/hardware/**/*.xlsx
docs/reference/hardware/**/*.ioc
docs/reference/hardware/**/*.docx

# Doxygen 生成输出（CI 发布到 Pages，不入库）
doxygen-out/
