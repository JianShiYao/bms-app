# Zephyr / west workspace
.west/
build/
build-*/
twister-out/
twister-out.*/

# 由 west update 拉取的依赖（不入本仓库）
# 注意：本仓库自带 zephyr/module.yml（模块注册文件，必须入库），
# 故忽略 zephyr 目录内容但放行 module.yml。
/zephyr/*
!/zephyr/module.yml
/modules/
/tools/
/bootloader/

# 编译产物
*.o
*.obj
*.elf
*.exe
*.bin
*.hex
*.map
*.lst

# Claude Code 运行期临时文件
.claude/scheduled_tasks.lock

# 编辑器/IDE
.vscode/
.idea/
*.swp
compile_commands.json

# Python venv（工具链）
.venv/
__pycache__/

# cppcheck MISRA addon（GPLv3，按机器下载，不入库；见 scripts/setup-cppcheck-misra.sh）
scripts/.cppcheck-addons/
# cppcheck 分析中间产物
*.dump
*.ctu-info
