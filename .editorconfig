root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C/C++: align with .clang-format (Zephyr style = tab, width 8) so the editor
# does not fight clang-format on save. clang-format remains the authority.
[*.{c,h,cpp,hpp}]
indent_style = tab
indent_size = 8

[*.{json,yml,yaml}]
indent_size = 2

[*.ps1]
indent_size = 4

[Makefile]
indent_style = tab
