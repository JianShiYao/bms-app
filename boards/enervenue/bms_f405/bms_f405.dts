/*
 * BMS STM32F405 自定义板 devicetree（模板）
 *
 * TODO（接入真实硬件时填写）：
 *   - 确认 SoC 变体 dtsi 路径（封装/Flash 容量）
 *   - 配置时钟树（HSE 晶振频率、PLL）
 *   - 配置 console UART 引脚（pinctrl）
 *   - 配置 ADC 通道（电压/电流/温度采样）
 *   - 配置 can1（对外通信）
 *   - 配置 GPIO：接触器控制、均衡开关
 */
/dts-v1/;

#include <st/f4/stm32f405Xg.dtsi>
#include <st/f4/stm32f405rgtx-pinctrl.dtsi>

/ {
	model = "BMS STM32F405 custom board";
	compatible = "enervenue,bms-f405";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	/* TODO: bms 相关别名/节点，例如接触器 GPIO、均衡 GPIO */
};

