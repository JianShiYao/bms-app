/*
 * BMS STM32F405 自定义板（enervenue / S16100B 目标）devicetree。
 *
 * 引脚权威（用户 2026-07-02 定案）：`docs/reference/hardware/software-interface.md` §9
 * （原理图 V0.4 校对版）+ 原理图 PDF 为准；`STM32F405RGT6_BMS.ioc`（CubeMX 草稿）弃用。
 *
 * 本增量：时钟地基 + console(USART1 PA9/10, §9 主 RS485 口)。其余外设（SPI2/AFE、
 * SPI1/flash、ADC1、IWDG、RTC）随各自 Phase 2-⑥/Phase 3 backend 逐个补（引脚照 §9）。
 * 注：USART1 物理上是隔离 RS485 主口（经 CA-IS2092A，方向脚 PA11=DE/RE）；此处作
 * 开发期 Zephyr console（RS485 收发方向控制与 Modbus 9600 属 Phase 3 comm 驱动，届时
 * 与 console 复用一并厘清）。
 *
 * 地基频率（.ioc 与 §9 一致，已确认）：HSE 8MHz、LSE 32.768k、SYSCLK 168MHz。
 */
/dts-v1/;

#include <st/f4/stm32f405Xg.dtsi>
#include <st/f4/stm32f405rgtx-pinctrl.dtsi>

/ {
	model = "BMS STM32F405 custom board (enervenue)";
	compatible = "enervenue,bms-f405";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};
};

/* 主 RS485 口 USART1（PA9 TX / PA10 RX，§9）——开发期作 Zephyr console。 */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/*
 * 时钟树：HSE 8MHz → PLL → SYSCLK 168MHz（F4 标准：VCO=8/8*336=336MHz，/P=2→168MHz，
 * /Q=7→48MHz 供 USB）。HSE/LSE 频率与 .ioc、原理图一致；bus 分频 AHB÷1/APB1÷4/APB2÷2。
 */
&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&clk_lse {
	status = "okay";
};

&pll {
	div-m = <8>;
	mul-n = <336>;
	div-p = <2>;
	div-q = <7>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(168)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;
	apb2-prescaler = <2>;
};
