# bms_f405 板级配置：时钟地基 + console(USART1) + 硬件看门狗(IWDG)。
# 其余外设子系统（ADC/SPI/COUNTER）随 Phase 3 backend 按需开。

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# 硬件看门狗：IWDG（hal/wdt STM32 后端；喂狗门控见 bms_sys_mon）。
CONFIG_WATCHDOG=y
CONFIG_BMS_WDT_BACKEND_STM32=y

# 板级外设子系统（编译级硬件描述，为 Phase 3 backend 铺路；引脚 §9）。
# RTC 延后到 Phase 3（需显式时钟源 dts + 时间源 backend）。
CONFIG_SPI=y
CONFIG_ADC=y
